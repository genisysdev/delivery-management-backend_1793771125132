{
  "name": "delivery-management-tool-api",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "API:production": "cross-env NODE_ENV=production node src/index.js",
    "seed:production": "cross-env NODE_ENV=production node src/seeder/seedData.js",
    "start:production": "npm run seed:production && npm run API:production",
    "API:test": "cross-env NODE_ENV=test node src/index.js",
    "seed:test": "cross-env NODE_ENV=test node src/seeder/seedData.js",
    "start:test": "npm run seed:test && npm run API:test",
    "API": "cross-env NODE_ENV=local node src/index.js",
    "seed": "cross-env NODE_ENV=local node src/seeder/seedData.js",
    "start": "npm run seed && npm run API",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "build": "babel src --out-dir dist/src --extensions \".js,.cjs\" --keep-file-extension"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "lodash": "^4.17.21",
    "mongoose": "^8.8.3",
    "nodemailer": "^7.0.5",
    "pm2": "^5.4.3",
    "uuid": "^11.0.3",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2"
  }
}
